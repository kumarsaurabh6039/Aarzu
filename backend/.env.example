# Supabase — Project Settings > API
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Google AI Studio — https://aistudio.google.com/apikey (free, no card needed)
GEMINI_API_KEY=your_gemini_api_key

# The fixed user id returned by the schema.sql seed insert
DEFAULT_USER_ID=paste_your_profile_uuid_here

# Models (Gemini free tier)
CHAT_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=models/text-embedding-004

# CORS — your deployed frontend URL (set after Vercel deploy)
FRONTEND_URL=http://localhost:5500
